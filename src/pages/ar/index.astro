  { href: '#equip', label: 'الأجهزة والبرمجيات SaaS' },
  { href: '#web', label: 'الحضور الرقمي' },
  { href: '#how', label: 'كيف نعمل' },
  { href: '#about', label: 'من نحن' },
];

const footerLinks = [
  { href: '/ar/privacy/', label: 'سياسة الخصوصية' },
  { href: '/ar/terms/', label: 'شروط الخدمة' },
  { href: '/ar/legal/', label: 'الشروط القانونية' },
  { href: 'https://wa.me/971565195654', label: 'واتساب' },
];
---

<TemplateLayout
  title="مستشارو تكنولوجيا المعلومات والذكاء الاصطناعي للشركات الصغيرة والمتوسطة والشركات الناشئة | الإمارات والدول الخليجية | VERSOHQ"
  description="مستشارون مستقلون في مجال تكنولوجيا المعلومات والذكاء الاصطناعي للشركات الصغيرة والمتوسطة والشركات الناشئة في الإمارات ودول الخليج. الأدوات المناسبة للذكاء الاصطناعي والأجهزة والبرمجيات SaaS — بدون عمولات من الموردين. أول مكالمة مجانية."
  lang="ar"
  navItems={navItems}
  footerLinks={footerLinks}
  ogLocale="ar_AE"
>
  <!-- HERO -->
  <section class="container hero">
    <div>
      <span class="eyebrow">معايير أوروبية. سرعة خليجية. نخدم الإمارات.</span>
      <h1>مستشارون مستقلون في تكنولوجيا المعلومات والذكاء الاصطناعي للشركات الصغيرة والمتوسطة والشركات الناشئة في جميع أنحاء الإمارات ودول الخليج.</h1>
      <p class="hero__lede">
        تساعد VERSOHQ الشركات الصغيرة في الإمارات على اختيار أدوات الذكاء الاصطناعي المناسبة، واختيار أفضل الأجهزة والبرامج التي تتناسب مع العمل الذي تقوم به فعليًا، وتوفير حضور رقمي موثوق واحترافي. لسنا متجرًا لMicrosoft ولا متجرًا لGoogle — نحن لا نأخذ عمولة من أي مورد، لذلك نوصي بما يناسب عملك ثم نقوم بإعداده لك.
      </p>
      <div class="hero__actions">
        <a href="https://wa.me/971565195654?text=مرحبًا%20VERSOHQ%20—%20أريد%20التحدث%20عن%20تقنية%20عملنا." class="btn btn--whatsapp" target="_blank" rel="noopener">ابدأ محادثة</a>
        <a href="#how" class="link-cta">اكتشف كيف نعمل</a>
      </div>
      <p class="hero__note">مُصمم للشركات الصغيرة والمتوسطة والشركات الناشئة في الإمارات ودول الخليج التي تفضل أن يكون لديها مستشار وليس موردًا.</p>
    </div>

    <div class="pillars-panel">
      <h2>ما الذي نقدمه للشركات الصغيرة والمتوسطة والشركات الناشئة في الإمارات ودول الخليج</h2>
      <div class="pillar-row">
        <span class="pillar-row__num">01</span>
        <div><strong>اعتماد الذكاء الاصطناعي</strong><span>الأدوات المناسبة للذكاء الاصطناعي لفريقك، مع الإعداد والتبني الصحيحين.</span></div>
      </div>
      <div class="pillar-row">
        <span class="pillar-row__num">02</span>
        <div><strong>تجهيز الفريق</strong><span>أفضل الأجهزة والبرمجيات SaaS لأداء العمل اليومي.</span></div>
      </div>
      <div class="pillar-row">
        <span class="pillar-row__num">03</span>
        <div><strong>الحضور الرقمي</strong><span>الاستضافة، البريد الإلكتروني، والموقع الإلكتروني الذي يعمل بشكل ممتاز.</span></div>
      </div>
      <p class="pillars-panel__foot">مبدأ واحد يربط بين الثلاثة: لا عمولات من الموردين، أبداً.</p>
    </div>
  </section>

  <!-- INDEPENDENCE BAND -->
  <section class="container section" aria-labelledby="indep-title">
    <div class="independence">
      <span class="independence__strap">// محايد للعلامات التجارية من التصميم</span>
      <h2 id="indep-title">مستشار تقنية معلومات محايد: لا نبيع العلامات التجارية، بل نوصي بما يعمل</h2>
      <p>Google أو Microsoft أو AWS أو أي شيء لم تسمع به من قبل — نحن لا نأخذ عمولة من أي منهم. كثير من مستشاري التقنية في الإمارات يدّعون الاستقلالية؛ نحن نثبت ذلك كتابةً ونعرض المقارنة وراء كل توصية. الشيء الوحيد الذي يوجه نصيحتنا هو ما يساعد عملك على النمو فعلاً.</p>
    </div>
  </section>

  <!-- THREE PILLARS -->
  <section class="container section" id="pillars" aria-labelledby="pillars-title">
    <span class="eyebrow">ثلاث طرق لنساعدك</span>
    <h2 id="pillars-title">خدمات استشارات تكنولوجيا المعلومات والذكاء الاصطناعي للشركات الصغيرة والمتوسطة والشركات الناشئة — نصائح قابلة للتنفيذ، مع الإعداد المنجز لك</h2>
    <p class="section-intro">أحضِر معنا تحديًا واحدًا أو كل الثلاثة. المبدأ نفسه يربط بين كل شيء: الأفضل لفرقك، وليس أكبر علامة تجارية.</p>

    <div class="card-grid">
      <article class="card card--p1" id="ai">
        <span class="card__num">01 — اعتماد الذكاء الاصطناعي</span>
        <h3>أدوات الذكاء الاصطناعي للشركات الصغيرة والمتوسطة والشركات الناشئة دون التخمين</h3>
        <p>نحدد أين يوفر الذكاء الاصطناعي ساعات حقيقية لفريقك، نقارن الخيارات بوضوح، ونوصي بما يناسب، ثم نقوم بإعداده وتدريب فريقك عليه. تحصل على نتائج، وليس مجرد اشتراك لن يفتح أحده.</p>
        <p class="card__how"><strong>كيف نعمل:</strong> نحدد المجموعة المختصرة ونوضح المنطق وراءها. أنت تقرر مع المقايضات أمامك.</p>
      </article>

      <article class="card card--p2" id="equip">
        <span class="card__num">02 — تجهيز الفريق</span>
        <h3>اختيار الأجهزة والبرمجيات SaaS بما يتناسب مع العمل الحقيقي</h3>
        <p>ننظر إلى طريقة عمل فريقك فعليًا، ثم نساعدك على اختيار الأجهزة والبرامج المناسبة — محايدة من حيث العلامات التجارية وأفضل قيمة ممكنة. كل شيء مُعد ومجهز قبل أن يصل إلى المكتب.</p>
        <p class="card__how"><strong>كيف نعمل:</strong> نقارن على أساس الملاءمة والقيمة، وليس على أساس من يدفع لنا — لأن nobody does.</p>
      </article>

      <article class="card card--p3" id="web">
        <span class="card__num">03 — الحضور الرقمي</span>
        <h3>موقع العمل، الاستضافة، والبريد الإلكتروني الذي يعمل بشكل ممتاز</h3>
        <p>استضافة احترافية، بريد إلكتروني تجاري موثوق، وحضور رقمي يمثل علامتك التجارية بشكل جيد — مع إعداد يضمن الاستمرارية وسرعة التحميل والاعتمادية دون الحاجة إلى التفكير في الأمر.</p>
        <p class="card__how"><strong>كيف نعمل:</strong> نختار الاستضافة والبريد الإلكتروني بما يناسب احتياجاتك، ثم نضمن استمرار عملهما لك.</p>
      </article>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="container section" id="how" aria-labelledby="how-title">
    <span class="eyebrow">كيف نعمل</span>
    <h2 id="how-title">كيف تسير استشارة تقنية المعلومات لدينا: من السؤال إلى الإعداد العملي في مسار مباشر</h2>
    <p class="section-intro">لا توجد باقات للاختيار من بينها. نبدأ من وضعك الحالي — أينما كنت في الإمارات — وكل شيء يتبع ذلك. أول مكالمة مجانية.</p>

    <div class="process-grid">
      <div class="process-step">
        <div class="process-step__num">01</div>
        <h3>نراجع</h3>
        <p>نتعرف على طريقة عمل فريقك اليوم — الأدوات، الأجهزة، والاحتكاك. بدون تكلفة أو التزام.</p>
      </div>
      <div class="process-step">
        <div class="process-step__num">02</div>
        <h3>نوصي</h3>
        <p>تحصل على قائمة مختصرة وواضحة، محايدة من حيث العلامات التجارية، مع شرح منطوقنا. أنت تختار مع المقايضات أمامك.</p>
      </div>
      <div class="process-step">
        <div class="process-step__num">03</div>
        <h3>نجهّز</h3>
        <p>نتولى المشتريات، الإعداد، والنشر، ونقوم بتدريب فريقك حتى تُستخدم الأدوات فعلاً.</p>
      </div>
      <div class="process-step">
        <div class="process-step__num">04</div>
        <h3>ندعم</h3>
        <p>نظل إلى جانبك مع تغير الأمور — موظفون جدد، احتياجات جديدة، أو أدوات جديدة تستحق التبديل إليها.</p>
      </div>
    </div>
  </section>

  <!-- PROMISES -->
  <section class="container section" aria-labelledby="promise-title">
    <span class="eyebrow">ما يمكنك الاعتماد عليه</span>
    <h2 id="promise-title">الالتزامات التي تقف وراء كل توصية تقنية</h2>
    <div class="promises">
      <div class="promise">
        <div class="promise__mark" aria-hidden="true">✓</div>
        <h3>لا عمولات من الموردين</h3>
        <p>نحن نُدفع من قبلك، وليس من أي مورد. لا توجد أي أجندة خفية وراء نصيحتنا.</p>
      </div>
      <div class="promise">
        <div class="promise__mark" aria-hidden="true">✓</div>
        <h3>أنت تملك كل شيء</h3>
        <p>الحسابات، النطاقات، والتراخيص مسجلة باسمك. أنت لا تكون مقيدًا بنا أبداً.</p>
      </div>
      <div class="promise">
        <div class="promise__mark" aria-hidden="true">✓</div>
        <h3>تكاليف شفافة</h3>
        <p>الأجهزة والبرمجيات تُمرر لك بالتكلفة الفعلية. رسومنا دائمًا منفصلة وواضحة.</p>
      </div>
      <div class="promise">
        <div class="promise__mark" aria-hidden="true">✓</div>
        <h3>الأفضل لعملك، وليس أكبر علامة تجارية</h3>
        <p>نوصي بالأداة التي تناسب فريقك — حتى لو كانت أرخص أو أصغر من غيرها.</p>
      </div>
    </div>
  </section>

  <!-- ABOUT / FOUNDERS -->
  <section class="container section" id="about" aria-labelledby="about-title">
    <span class="eyebrow u-center">الناس وراء VERSOHQ</span>
    <div class="story">
      <h2 id="about-title" class="u-mb-20">بدأ العمل برأسي شخصين سئما من رؤية الشركات الصغيرة والمتوسطة والشركات الناشئة في الإمارات ودول الخليج تدفع أكثر من اللازم مقابل تقنية غير مناسبة</h2>
      <p>بعد سنوات من مشاهدة الشركات الصغيرة والمتوسطة والشركات الناشئة تدفع أموالًا مقابل برمجيات لم تستخدمها بالكامل وأجهزة لم تناسب العمل، أسس Suleiman وVera VERSOHQ على فكرة بسيطة: جلب دقة وشفافية الممارسة التقنية الأوروبية إلى سرعة العمل في الخليج. لا عمولات من الموردين، ولا ولاء للعلامات التجارية — فقط نصيحة صادقة وإعداد يتم بشكل صحيح، حتى يتمكن فريق مكون من خمسة أشخاص من اتخاذ قرارات تقنية بنفس جودة الشركة التي تكبر عشر مرات.</p>
    </div>

    <div class="founders">
      <article class="founder">
        <div class="founder__photo"><img src="/suleiman.jpg" alt="Suleiman، الشريك المؤسس في VERSOHQ، مسؤول التكنولوجيا والاستشارات" width="88" height="88" loading="lazy" decoding="async"></div>
        <h3>Suleiman</h3>
        <p class="founder__role">الشريك المؤسس — التكنولوجيا والاستشارات</p>
        <p>25 عامًا من الخبرة في تكنولوجيا المعلومات المؤسسية عبر أوروبا والشرق الأوسط وشمال أفريقيا، من البنية التحتية إلى إطلاق حلول SaaS للشركات الناشئة والمتنامية. يقود Suleiman طريقة تقييم VERSOHQ للأدوات وبناء البنية التقنية لكل عميل — دائمًا محايدًا من حيث العلامات التجارية وضمن ملكية العميل.</p>
      </article>

      <article class="founder">
        <div class="founder__photo"><img src="/vera.jpg" alt="Vera، الشريكة المؤسّسة في VERSOHQ، مسؤولة العمليات ونجاح العملاء" width="88" height="88" loading="lazy" decoding="async"></div>
        <h3>Vera</h3>
        <p class="founder__role">الشريكة المؤسّسة — العمليات ونجاح العملاء</p>
        <p>خلفية في الاستثمار والعمليات للشركات الصغيرة والمتوسطة الأوروبية، مع تركيز قوي على جعل الفرق تستخدم الأدوات التي تستثمر فيها فعليًا. تدير Vera علاقات العملاء والتسليم في VERSOHQ، وتضمن أن تتحول كل توصية إلى شيء يعمل يوميًا.</p>
      </article>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container section" id="faq" aria-labelledby="faq-title">
    <span class="eyebrow">مفيد أن تعرف</span>
    <h2 id="faq-title">الأسئلة التي يطرحها أصحاب الأعمال في الإمارات ودول الخليج قبل التواصل معنا</h2>

    <div class="faq">
      <details>
        <summary>هل تأخذون عمولات من Microsoft أو Google أو أي مورد آخر؟</summary>
        <p>لا. نحن لا نأخذ عمولة أو رشا من أي مورد. أنت تدفع لنا مقابل المشورة والعمل؛ بينما تُمرر لك الأدوات بالتكلفة الفعلية. هذه هي الفكرة الأساسية للاستقلالية — وهي الطريقة الوحيدة التي يمكن أن تكون فيها التوصية مبنية على احتياجك الحقيقي.</p>
      </details>
      <details>
        <summary>هل نملك حساباتنا ونطاقاتنا الخاصة؟</summary>
        <p>نعم، دائمًا. كل ترخيص أو نطاق أو حساب نعده يُسجل باسمك وتحت سيطرتك. وإذا قررت لاحقًا العمل مع شخص آخر، يبقى كل شيء ملكًا لك وسنساعدك على تسليمه بشكل نظيف.</p>
      </details>
      <details>
        <summary>ما حجم الأعمال التي تعملون معها؟</summary>
        <p>المكاتب الصغيرة والشركات المتنامية الصغيرة والمتوسطة والشركات الناشئة — من شخص واحد إلى نحو خمسين شخصًا. نحن مصممون للفرق التي تحتاج إلى حكم قسم تكنولوجيا المعلومات دون تكلفة توظيفه.</p>
      </details>
      <details>
        <summary>هل يجب أن نأخذ المجالات الثلاثة جميعها؟</summary>
        <p>لا على الإطلاق. يمكنك القدوم إلينا بتحدٍ واحد — سواء كان اعتماد الذكاء الاصطناعي، اختيار الأجهزة والبرمجيات، أو ترتيب موقعك الإلكتروني والبريد الإلكتروني — أو بكل الثلاثة. نحن نعمل على ما تحتاجه فعلاً.</p>
      </details>
      <details>
        <summary>أين تعملون في الإمارات ودول الخليج؟</summary>
        <p>نعمل مع شركات في جميع أنحاء الإمارات ودول الخليج. معظم العمل على المراجعة والتوصية يتم عن بُعد؛ بينما يمكن تنفيذ الإعداد والنشر onsite عندما يكون ذلك مفيدًا.</p>
      </details>
      <details>
        <summary>كم تكلفة العمل معنا؟</summary>
        <p>أول مكالمة مجانية. وبعدها تدفع رسمًا واضحًا للاستشارات أو المشروع، وأي أجهزة أو برمجيات تُمرر إليك بالتكلفة الفعلية مع الفاتورة المعروضة. لا يوجد هامش إضافي، ولا عمولة، ولا تسعير مختلط يخفي أين تذهب الأموال.</p>
      </details>
      <details>
        <summary>ما الفرق بينكم وبين شركة دعم تقنية المعلومات؟</summary>
        <p>غالبًا ما تبيع شركة دعم التقنية شيئًا — ترخيصًا، جهازًا، أو عقدًا مُدارًا — وتكسب من ما تبيعه. نحن نكسب فقط من النصيحة والعمل، لذلك يمكننا أن نخبرك عندما يكون الخيار الأرخص هو الأفضل، أو عندما لا تحتاج إلى شراء أي شيء على الإطلاق.</p>
      </details>
      <details>
        <summary>أنتم حديثو العهد. لماذا ينبغي لنا أن نثق بكم؟</summary>
        <p>سؤال عادل. نفضل أن تحكم علينا من خلال طريقة العمل لا من خلال جدار الشعارات. أول مكالمة لا تكلف شيئًا، وكل ما نجهزه لك يظل ملكًا لك، وسعرنا شفاف من التصميم. وإذا لم نكن الخيار المناسب، سنخبرك بذلك.</p>
      </details>
    </div>
  </section>

  <!-- CONTACT / WHATSAPP -->
  <section class="container section" id="contact" aria-labelledby="contact-title">
